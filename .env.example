GATEWAY_HOST_PORT=8080
GATEWAY_INTERNAL_PORT=8081
FRONTEND_PORTAL_HOST_PORT=5173
FRONTEND_ADMIN_HOST_PORT=5174

POSTGRES_USER=bedarce
POSTGRES_PASSWORD=bedarce_local_only_change_me
POSTGRES_DB_USUARIOS=bedarce_usuarios
POSTGRES_DB_ATENDIMENTO=bedarce_atendimento
POSTGRES_DB_GAMIFICACAO=bedarce_gamificacao

PORT_BFF_PORTAL=4000
PORT_BFF_ADMIN=4001
PORT_USUARIOS=5000
PORT_ATENDIMENTO=5001
PORT_GAMIFICACAO_ESCRITA=5002
PORT_GAMIFICACAO_LEITURA=5003
PORT_COMUNIDADE=5004
PORT_SAGA=5005

MONGO_URI_GAMIFICACAO=mongodb://db-gamificacao-leitura:27017/bedarce_gamificacao_leitura
MONGO_URI_COMUNIDADE=mongodb://db-comunidade:27017/bedarce_comunidade

GATEWAY_INTERNAL_URL=http://localhost:8081

# Assistente de IA
PORT_ASSISTENTE=5006
CHROMA_DIR=./chroma_db

# Provedor principal: "groq", "google_genai", "ollama" ou "openai"
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-20b
LLM_TEMPERATURE=0.1
LLM_TIMEOUT_SECONDS=15

# Provedor secundário opcional para fallback entre modelos (ex: "ollama" ou "google_genai")
LLM_FALLBACK_PROVIDER=
LLM_FALLBACK_MODEL=

# Chaves de API (preencha apenas a do provedor que for usar)
GROQ_API_KEY=API_GROQ
GOOGLE_API_KEY=
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://host.docker.internal:11434
